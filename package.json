{
  "name": "tournament-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Esports tournament escrow with token prizes and fixed-rate redemption",
  "scripts": {
    "check": "npm run compile && npm test && npm run analyze",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "demo": "hardhat run scripts/demo.js",
    "ui:sepolia": "npm run compile && node scripts/configure-ui.js",
    "read:sepolia": "npm run compile && node scripts/check-tournament-demo.js --public-rpc",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "node": "hardhat node",
    "serve": "node scripts/serve.js",
    "analyze": "node scripts/analyze.js",
    "preflight": "node scripts/preflight.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.4",
    "@openzeppelin/contracts": "5.6.1",
    "chai": "4.5.0",
    "dotenv": "16.6.1",
    "ethers": "6.17.0",
    "hardhat": "2.29.2",
    "solc": "0.8.26",
    "solidity-coverage": "0.8.17"
  },
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  }
}
