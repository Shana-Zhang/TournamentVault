{
  "name": "tournament-vault",
  "version": "1.0.0",
  "private": true,
  "description": "ETH prize escrow with optional LRT bonuses for esports tournaments",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "demo": "hardhat run scripts/demo.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:local:v3": "hardhat run scripts/deploy-local-v3.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:sepolia:v2": "hardhat run scripts/deploy-v2.js --network sepolia",
    "deploy:sepolia:v3": "hardhat run scripts/deploy-v3.js --network sepolia",
    "smoke:sepolia:v2": "hardhat run scripts/smoke-v2-sepolia.js --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "verify:sepolia:v2": "hardhat run scripts/verify-v2.js --network sepolia",
    "verify:sepolia:v3": "hardhat run scripts/verify-v3.js --network sepolia",
    "check:sepolia:v2": "node scripts/read-only-check.js sepolia-v2",
    "check:sepolia:v3": "node scripts/read-only-check.js sepolia-v3",
    "config:check": "node scripts/check-ui-config.js",
    "node": "hardhat node",
    "serve": "node scripts/serve.js",
    "analyze": "node scripts/analyze.js",
    "preflight": "node scripts/preflight.js",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.4",
    "@openzeppelin/contracts": "5.6.1",
    "chai": "4.5.0",
    "dotenv": "16.6.1",
    "ethers": "6.17.0",
    "hardhat": "2.29.2",
    "solc": "0.8.26",
    "solidity-coverage": "0.8.17"
  }
}
